# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_INITIAL_PASSWORD: Optional initial password for the admin account on first database creation.
# If omitted, a cryptographically secure random password is generated and logged once during first setup.
ADMIN_INITIAL_PASSWORD=

# ADMIN_RESET_PASSWORD: Set this environment variable (min 8 chars) to securely reset or bootstrap
# the administrator password for existing databases. Forces mustChangePassword=true on next login.
ADMIN_RESET_PASSWORD=

# ADMIN_USERNAME: Optional custom administrator username (defaults to 'admin').
ADMIN_USERNAME=

# EXCHANGE_RATE_API_KEY: Optional API key for ExchangeRate-API live market currency rates.
EXCHANGE_RATE_API_KEY=
